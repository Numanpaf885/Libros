# Copy to .env.local and fill in. Never commit real values.

# "mock" = in-memory sheet + local files in .data/ (no Google/Cloudflare needed). Remove for production.
DATA_BACKEND=
# Mock mode only: password for the seeded admin user "admin" (default admin123)
MOCK_ADMIN_PASSWORD=

# Random string, 32+ chars. Signs admin and reader cookies. e.g.  openssl rand -base64 48
SESSION_SECRET=

# Google Sheets (service account)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key with literal \n sequences, wrapped in double quotes
GOOGLE_PRIVATE_KEY=
SHEET_ID=

# Cloudflare R2 (private bucket, API token limited to that bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional public copy (Spanish defaults are built in; the site is called "Libros")
SITE_NAME=
# One line of intro text shown in the footer
SITE_INTRO=
# Line shown under the code box, e.g. how to ask for a code
SITE_CONTACT=
# Footer contact links: leave empty to hide
SITE_EMAIL=
SITE_INSTAGRAM=
SITE_WHATSAPP=
